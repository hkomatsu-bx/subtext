# Subtext 設定テンプレート（Unit B / 会議後パイプライン, FR-15）。
# このファイルをコピーして **リポジトリルートに** `.env` を作成する（workspace 化により
# 各 CLI はルートから実行するため、.env もルートで読まれる）。
# 実値・認証情報は .env にのみ記入し、コミットしない（BR-SEC-01）。
# AWS 認証情報はここに書かない（NFR-SEC-07）。AWS プロファイル / SSO / 環境変数で解決する。

# 文字起こし・推論を行う AWS リージョン（NFR-07）。
AWS_REGION=ap-northeast-1

# 処理用 S3 バケット名（暗号化・パブリックアクセスブロック前提, BR-IO-01）。CDK の出力を転記。
S3_BUCKET=

# 処理用プレフィックス。
S3_PREFIX=subtext/jobs/

# Bedrock モデル ID（FR-15, Q5=A）。東京リージョンで有効化済みのモデル ID を記入。
BEDROCK_MODEL_ID=

# 文字起こし言語（NFR-07）。
LANGUAGE=ja-JP

# others 系統の最大話者数（FR-08, NFR-02）。
MAX_SPEAKERS=5

# Transcribe ジョブ完了待ちのポーリング上限秒（Q8=A）。
POLL_TIMEOUT_SEC=1800

# ジョブ成功後に S3 オブジェクトを保持するか（既定 false=削除, BR-IO-02）。
KEEP_S3=false

# 中間/最終成果物の出力先。会議ハーネス（meeting）はこの値を data/out に自動注入する。
# 直接 `uv run subtext-postmeeting` する場合の既定として data/out を推奨。
OUTPUT_DIR=data/out

# カスタム語彙名（C1・任意）。未設定なら語彙なし（従来動作）。tools/vocab で投入した名前を記入。
VOCABULARY_NAME=

# 用語補正（C2）の用語ファイル。未設定なら tools/correction/terms.json を使う。
CORRECTION_TERMS_PATH=

# Slack Bot Token（`meeting slack` / `meeting process` / TUI の投稿で必須。未設定だと投稿だけ失敗する）。
# xoxb- で始まる値。環境変数が優先され、無ければこの .env から読む。ログには出さない（BR-SEC-01）。
SLACK_BOT_TOKEN=
