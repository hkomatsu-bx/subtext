        <!-- Entities -->
        <mxCell id="E-001" value="&lt;b&gt;User (E-001)&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔑 PK id&lt;br&gt;email (UNIQUE)&lt;br&gt;name&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="200" height="130" as="geometry" /></mxCell>
        <mxCell id="E-003" value="&lt;b&gt;Project (E-003)&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔑 PK id&lt;br&gt;🔗 FK owner_id → User&lt;br&gt;name&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="200" height="130" as="geometry" /></mxCell>
        <mxCell id="E-002" value="&lt;b&gt;Task (E-002)&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔑 PK id&lt;br&gt;🔗 FK user_id → User&lt;br&gt;🔗 FK project_id → Project&lt;br&gt;title&lt;br&gt;status&lt;br&gt;due_date&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="220" height="180" as="geometry" /></mxCell>
        <mxCell id="E-005" value="&lt;b&gt;TaskLabel (E-005)&lt;/b&gt;&lt;br&gt;&lt;i&gt;中間テーブル（N..N解消）&lt;/i&gt;&lt;br&gt;&lt;br&gt;🔗 FK task_id → Task&lt;br&gt;🔗 FK label_id → Label" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="380" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="E-004" value="&lt;b&gt;Label (E-004)&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔑 PK id&lt;br&gt;name&lt;br&gt;color" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="390" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="E-006" value="&lt;b&gt;Notification (E-006)&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔑 PK id&lt;br&gt;🔗 FK user_id → User&lt;br&gt;🔗 FK task_id → Task&lt;br&gt;type&lt;br&gt;sent_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="200" height="150" as="geometry" /></mxCell>

